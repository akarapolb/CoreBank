{
  "title": "Fabor OS · Ledger (RED)",
  "uid": "fabor-ledger-red",
  "schemaVersion": 39,
  "refresh": "10s",
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Appends per second by outcome", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "targets": [{"expr": "sum by (outcome) (rate(fabor_ledger_append_seconds_count[1m]))", "legendFormat": "{{outcome}}"}]},
    {"id": 2, "type": "timeseries", "title": "Append latency p50 / p99 (budget 50 ms)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.05}]}}},
     "targets": [
       {"expr": "histogram_quantile(0.5, sum by (le) (rate(fabor_ledger_append_seconds_bucket[1m])))", "legendFormat": "p50"},
       {"expr": "histogram_quantile(0.99, sum by (le) (rate(fabor_ledger_append_seconds_bucket[1m])))", "legendFormat": "p99"}]},
    {"id": 3, "type": "stat", "title": "Unexpected error ratio (5m)", "gridPos": {"x": 0, "y": 8, "w": 6, "h": 4},
     "targets": [{"expr": "sum(rate(fabor_ledger_append_seconds_count{outcome=\"error\"}[5m])) / clamp_min(sum(rate(fabor_ledger_append_seconds_count[5m])), 1)"}]},
    {"id": 4, "type": "stat", "title": "Overdraft refusals / min", "gridPos": {"x": 6, "y": 8, "w": 6, "h": 4},
     "targets": [{"expr": "sum(rate(fabor_ledger_append_seconds_count{outcome=\"insufficient_funds\"}[1m])) * 60"}]},
    {"id": 5, "type": "timeseries", "title": "Read latency p99 by operation", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"expr": "histogram_quantile(0.99, sum by (le, op) (rate(fabor_ledger_read_seconds_bucket[1m])))", "legendFormat": "{{op}}"}]}
  ]
}
